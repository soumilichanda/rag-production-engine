{
  "openapi": "3.1.0",
  "info": {
    "title": "Production RAG Engine",
    "description": "Vector retrieval microservice with semantic caching and latency telemetry profiling",
    "version": "1.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/telemetry": {
      "get": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Telemetry Stats",
        "operationId": "telemetry_stats_v1_telemetry_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/index": {
      "post": {
        "tags": [
          "Ingestion"
        ],
        "summary": "Index Documents",
        "operationId": "index_documents_v1_index_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/retrieve": {
      "post": {
        "tags": [
          "Retrieval"
        ],
        "summary": "Retrieve Context",
        "operationId": "retrieve_context_v1_retrieve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/diagnostics/health": {
      "get": {
        "tags": [
          "diagnostics"
        ],
        "summary": "Health Check",
        "description": "Liveness probe returning process uptime status.",
        "operationId": "health_check_v1_diagnostics_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/diagnostics/telemetry": {
      "get": {
        "tags": [
          "diagnostics"
        ],
        "summary": "Telemetry Probe",
        "description": "Readiness probe reporting operational telemetry parameters.",
        "operationId": "telemetry_probe_v1_diagnostics_telemetry_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DocumentChunk": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "Deterministic unique identifier for the chunk"
          },
          "text": {
            "type": "string",
            "minLength": 5,
            "title": "Text",
            "description": "Raw chunk text payload"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Arbitrary metadata dictionary"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "text"
        ],
        "title": "DocumentChunk"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestionRequest": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentChunk"
            },
            "type": "array",
            "minItems": 1,
            "title": "Documents",
            "description": "List of document chunks to index"
          }
        },
        "type": "object",
        "required": [
          "documents"
        ],
        "title": "IngestionRequest"
      },
      "IngestionResponse": {
        "properties": {
          "ingested_count": {
            "type": "integer",
            "title": "Ingested Count"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "success"
          }
        },
        "type": "object",
        "required": [
          "ingested_count"
        ],
        "title": "IngestionResponse"
      },
      "QueryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "title": "Query",
            "description": "Natural language search query"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "Maximum number of chunks to retrieve",
            "default": 3
          },
          "score_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score Threshold",
            "description": "Minimum cosine similarity cutoff",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "QueryRequest"
      },
      "QueryResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RetrievedChunk"
            },
            "type": "array",
            "title": "Results"
          },
          "retrieved_count": {
            "type": "integer",
            "title": "Retrieved Count"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          }
        },
        "type": "object",
        "required": [
          "query",
          "results",
          "retrieved_count",
          "latency_ms"
        ],
        "title": "QueryResponse"
      },
      "RetrievedChunk": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "similarity_score": {
            "type": "number",
            "title": "Similarity Score"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "text",
          "similarity_score"
        ],
        "title": "RetrievedChunk"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}