            }
          }
        }
      }
    },
    "/v1/diagnostics/telemetry": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Diagnostics Telemetry",
        "operationId": "diagnostics_telemetry_v1_diagnostics_telemetry_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/index": {
      "post": {
        "tags": [
          "Ingestion"
        ],
        "summary": "Index Documents",
        "operationId": "index_documents_v1_index_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/retrieve": {
      "post": {
        "tags": [
          "Retrieval"
        ],
        "summary": "Retrieve Context",
        "operationId": "retrieve_context_v1_retrieve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/retrieve/compressed": {
      "post": {
        "tags": [
          "Retrieval"
        ],
        "summary": "Retrieve Compressed Context",
        "operationId": "retrieve_compressed_context_v1_retrieve_compressed_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/generate": {
      "post": {
        "tags": [
          "Generation"
        ],
        "summary": "Generate Response",
        "operationId": "generate_response_v1_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pipeline/assemble": {
      "post": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Assemble Prompt Context",
        "operationId": "assemble_prompt_context_v1_pipeline_assemble_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromptAssemblyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssembledPrompt"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pipeline/evaluate": {
      "post": {
        "tags": [
          "Evaluation"
        ],
        "summary": "Evaluate Pipeline Response",
        "description": "Evaluates response faithfulness against retrieved context chunks.",
        "operationId": "evaluate_pipeline_response_v1_pipeline_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluatePayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pipeline/stream": {
      "post": {
        "tags": [
          "Generation"
        ],
        "summary": "Stream Generation Pipeline",
        "operationId": "stream_generation_pipeline_v1_pipeline_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssembledPrompt": {
        "properties": {
          "system_prompt": {
            "type": "string",
            "title": "System Prompt"
          },
          "user_prompt": {
            "type": "string",
            "title": "User Prompt"
          },
          "formatted_context": {
            "type": "string",
            "title": "Formatted Context"
          },
          "retained_chunks_count": {
            "type": "integer",
            "title": "Retained Chunks Count"
          },
          "total_estimated_tokens": {
            "type": "integer",
            "title": "Total Estimated Tokens"
          },
          "provenance_sources": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Provenance Sources"
          }
        },
        "type": "object",
        "required": [
          "system_prompt",
          "user_prompt",
          "formatted_context",
          "retained_chunks_count",
          "total_estimated_tokens",
          "provenance_sources"
        ],
        "title": "AssembledPrompt"
      },
      "DocumentChunk": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "Deterministic unique identifier for the chunk"
          },
          "text": {
            "type": "string",
            "minLength": 5,
            "title": "Text",
            "description": "Raw chunk text payload"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Arbitrary metadata dictionary"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "text"
        ],
        "title": "DocumentChunk"
      },
      "EvaluatePayload": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "contexts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Contexts"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold",
            "default": 0.5
          }
        },
        "type": "object",
        "required": [
          "answer",
          "contexts"
        ],
        "title": "EvaluatePayload"
      },
      "GenerationResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations"
          },
          "retrieved_count": {
            "type": "integer",
            "title": "Retrieved Count",
            "default": 0
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "query",
          "answer"
        ],
        "title": "GenerationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestionRequest": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentChunk"
            },
            "type": "array",
            "minItems": 1,
            "title": "Documents",
            "description": "List of document chunks to index"
          }
        },
        "type": "object",
        "required": [
          "documents"
        ],
        "title": "IngestionRequest"
      },
      "IngestionResponse": {
        "properties": {
          "ingested_count": {
            "type": "integer",
            "title": "Ingested Count"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "success"
          }
        },
        "type": "object",
        "required": [
          "ingested_count"
        ],
        "title": "IngestionResponse"
      },
      "PromptAssemblyRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "chunks": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Chunks"
          },
          "max_context_tokens": {
            "type": "integer",
            "title": "Max Context Tokens",
            "default": 1500
          },
          "system_instruction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "System Instruction"
          }
        },
        "type": "object",
        "required": [
          "query",
          "chunks"
        ],
        "title": "PromptAssemblyRequest"
      },
      "QueryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "title": "Query",
            "description": "Natural language search query"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "Maximum number of chunks to retrieve",
            "default": 3
          },
          "score_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score Threshold",
            "description": "Minimum cosine similarity cutoff",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "QueryRequest"
      },
      "QueryResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RetrievedChunk"
            },
            "type": "array",
            "title": "Results"
          },
          "retrieved_count": {
            "type": "integer",
            "title": "Retrieved Count"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          }
        },
        "type": "object",
        "required": [
          "query",
          "results",
          "retrieved_count",
          "latency_ms"
        ],
        "title": "QueryResponse"
      },
      "RetrievedChunk": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "similarity_score": {
            "type": "number",
            "title": "Similarity Score"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "text",
          "similarity_score"
        ],
        "title": "RetrievedChunk"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}