  "components": {
    "schemas": {
      "AssembledPrompt": {
        "properties": {
          "system_prompt": {
            "type": "string",
            "title": "System Prompt"
          },
          "user_prompt": {
            "type": "string",
            "title": "User Prompt"
          },
          "formatted_context": {
            "type": "string",
            "title": "Formatted Context"
          },
          "retained_chunks_count": {
            "type": "integer",
            "title": "Retained Chunks Count"
          },
          "total_estimated_tokens": {
            "type": "integer",
            "title": "Total Estimated Tokens"
          },
          "provenance_sources": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Provenance Sources"
          }
        },
        "type": "object",
        "required": [
          "system_prompt",
          "user_prompt",
          "formatted_context",
          "retained_chunks_count",
          "total_estimated_tokens",
          "provenance_sources"
        ],
        "title": "AssembledPrompt"
      },
      "CacheInvalidationRequest": {
        "properties": {
          "tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tag"
          },
          "flush_all": {
            "type": "boolean",
            "title": "Flush All",
            "default": false
          }
        },
        "type": "object",
        "title": "CacheInvalidationRequest"
      },
      "DocumentChunk": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id",
            "description": "Deterministic unique identifier for the chunk"
          },
          "text": {
            "type": "string",
            "minLength": 5,
            "title": "Text",
            "description": "Raw chunk text payload"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Arbitrary metadata dictionary"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "text"
        ],
        "title": "DocumentChunk"
      },
      "EvaluatePayload": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "contexts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Contexts"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold",
            "default": 0.5
          }
        },
        "type": "object",
        "required": [
          "answer",
          "contexts"
        ],
        "title": "EvaluatePayload"
      },
      "GenerationResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations"
          },
          "retrieved_count": {
            "type": "integer",
            "title": "Retrieved Count",
            "default": 0
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "query",
          "answer"
        ],
        "title": "GenerationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestionRequest": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentChunk"
            },
            "type": "array",
            "minItems": 1,
            "title": "Documents",
            "description": "List of document chunks to index"
          }
        },
        "type": "object",
        "required": [
          "documents"
        ],
